%test

  print $((1 + 2 * 3)) $(( (1 + 2) * 3 )) $((7 / 2)) $((-7 % 3)) $((2 ** 10))
0:Integer arithmetic
>7 9 3 -1 1024

  print $((7 / 2.0)) $((3.0)) $((1 / 3.0)) $((0.1 + 0.2))
0:Floating point
>3.5 3. 0.33333333333333331 0.30000000000000004

  print $((16#ff)) $((0x1f)) $((2#101)) $(( [#16] 255 )) $(( [##2] 5 ))
0:Bases
>255 31 5 16#FF 101

  print $((010)); setopt octalzeroes; print $((010))
0:OCTAL_ZEROES
>10
>8

  i=5; print $((i++ + ++i)) $i
0:Increment operators
>12 7

  x=3; (( x *= 2, x += 1 )); print $x
0:Assignment operators
>7

  print $(( 5 > 3 ? 10 : 20 )) $(( 1 && 0 || 2 ))
0:Ternary and logical
>10 1

  (( 0 )); print $?; (( 2 )); print $?
0:(( )) status
>1
>0

  print $((1 / 0))
1:Division by zero
?zsh:1: division by zero

  print $(( 1 + ))
1:Syntax error
?zsh:1: bad math expression: operand expected at end of string

  x='1+2'; print $((x * 2))
0:Parameter values are expressions
>6

  a=(10 20 30); print $((a[2] + a[-1]))
0:Array elements in arithmetic
>50

  print $((##a)) $((#HOME > 0))
0:Character codes
>97 1

  print $[3 * 4]
0:Old $[...] syntax
>12

  integer n=9223372036854775807; print $((n + 1))
0:Integer overflow wraps
>-9223372036854775808

  let 'v = 6 * 7'; print $v
0:let
>42
