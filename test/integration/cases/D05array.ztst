%test

  a=(one two three four five); print $a[2] $a[-1] $a[2,3] ${#a}
0:Indexing
>two five two three 5

  a=(one two three); print "${a[@]}" "$a"
0:Quoted arrays
>one two three one two three

  a=(one 'two words'); print -l "${a[@]}"
0:"${a[@]}" keeps elements
>one
>two words

  a=(one 'two words'); print -l "$a[*]"
0:"$a[*]" joins
>one two words

  a=(); print ${#a} "[${a[@]}]"
0:Empty array
>0 []

  a=(x y z); print ${a[(i)y]} ${a[(r)z*]} ${a[(I)q]}
0:Search subscripts
>2 z 0

  a=(one two three); print ${a:#t*} ${(M)a:#t*}
0:Array filtering
>one two three

  a=(1 2 3) b=(2 3 4); print ${a:|b} ${a:*b} ${a:^b}
0:Set operations and zip
>1 2 3 1 2 2 3 3 4

  a=(a b); print x${a}y x${^a}y
0:RC_EXPAND_PARAM with ^
>xa by xay xby

  a=(a b c); a[2]=(); print $a $#a
0:Removing an element
>a c 2

  setopt ksharrays; a=(a b c); print ${a[0]} ${a[1]} $a
0:KSH_ARRAYS
>a b a

  set -- p1 'p 2'; print $# $1; print -l "$@"
0:Positional parameters
>2 p1
>p1
>p 2

  set -- a b; argv[2]=B; print $@
0:argv
>a B

  typeset -A h; h=(k1 v1 k2 v2); print ${(o)${(k)h}} ${(o)${(v)h}} ${(kv)#h}
0:Associative keys and values
>k1 k2 v1 v2 4

  typeset -A h; h=(a 1); print ${+h[a]} ${+h[b]}
0:Assoc element existence
>1 0
